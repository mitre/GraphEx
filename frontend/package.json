{
	"name": "graphex",
	"version": "1.1.1",
	"private": true,
	"author": "MITRE",
	"license": "ISC",
	"scripts": {
		"dev": "vite",
		"dev-server": "run-p dev watch-server",
		"watch": "nodemon --watch src --ext 'js,ts,vue' --exec 'npm run build'",
		"watch-server": "nodemon --watch ../graphex --ext py --exec 'cd .. && python3 -m graphex serve --port 8080 --root ./graphex'",
		"build": "run-p type-check build-only",
		"build-only": "vite build",
		"type-check": "vue-tsc --noEmit",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
		"format": "prettier --write src/"
	},
	"dependencies": {
		"@codemirror/lang-html": "6.4.11",
		"@codemirror/lang-javascript": "6.2.4",
		"@codemirror/lang-json": "github:codemirror/lang-json",
		"@codemirror/lang-markdown": "github:codemirror/lang-markdown",
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/lang-xml": "github:codemirror/lang-xml",
		"@codemirror/legacy-modes": "6.5.2",
		"@fontsource/roboto": "4.5.8",
		"@fontsource/roboto-mono": "5.2.8",
		"codemirror": "6.0.2",
		"color": "4.2.3",
		"material-icons": "1.13.14",
		"pinia": "2.3.1",
		"socket.io-client": "4.8.1",
		"uuid": "9.0.1",
		"vue": "3.5.24",
		"yaml": "2.8.1"
	},
	"devDependencies": {
		"@types/color": "3.0.6",
		"@types/node": "^20.0.0",
		"@types/uuid": "9.0.8",
		"@vitejs/plugin-vue": "5.2.4",
		"@eslint/js": "9.39.1",
		"eslint": "9.39.1",
		"eslint-plugin-vue": "9.33.0",
		"@typescript-eslint/eslint-plugin": "8.47.0",
		"@typescript-eslint/parser": "8.47.0",
		"marked": "12.0.2",
		"nodemon": "3.1.11",
		"npm-run-all": "4.1.5",
		"prettier": "3.6.2",
		"typescript": "5.9.3",
		"vite": "5.4.21",
		"vue-tsc": "2.2.12"
	},
	"engines": {
		"node": ">=18.18"
	}
}
